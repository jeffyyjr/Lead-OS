# Copy to .env for local runs (on Render, set these under Environment instead).
# Never commit .env.

# Gmail: use an App Password, not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Lead-OS
EMAIL_SUBJECT=About your service request

# Claude AI brain (https://console.anthropic.com). Without it, scripted replies are used.
ANTHROPIC_API_KEY=

# Required to view or change business settings (/api/tenants). Pick a long random value.
ADMIN_API_KEY=

# Optional
# DATABASE_URL=postgresql://...  (leave unset to use a local SQLite file)
MESSAGING_WEBHOOK_URL=
CRM_WEBHOOK_URL=
